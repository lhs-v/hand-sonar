<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".HandSonarPhoneApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.HandSonar">

        <!-- 안드로이드 16부터 큰 화면(가장 짧은 변 600 dp 이상)에서는 방향 고정이 무시된다.
             targetSdk 36까지 되는 예외 신청으로 가로 고정을 지킨다(폴드8 가로 펼침 기준 화면). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 워치 녹음 받기(전송 설계 §2). 데이터 레이어가 앱이 꺼져 있어도 이 서비스를 깨운다. 경로로 이 앱의 목록 요청·채널만 받는다. -->
        <service
            android:name=".transfer.WatchReceiverService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/hand-sonar/offer"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/hand-sonar/rec/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
