# Gradle·Android 빌드 결과
.gradle/
.kotlin/
build/
.cxx/
captures/
*.apk
*.aab

# 기기마다 다른 설정(SDK 경로, 서명 키 경로)
local.properties

# 서명 키 파일은 공개 저장소에 넣지 않는다(README "서명")
*.keystore
*.jks

# IDE
.idea/
*.iml

# 파이썬
__pycache__/
*.pyc

# MediaPipe 손 모델: 빌드할 때 내려받는다(mobile/build.gradle.kts)
mobile/src/main/assets/hand_landmarker.task

# 수집 데이터는 넣지 않는다(얼굴이 찍힌 영상 포함)
*.wav
*.mp4

# PC 도구 결과(프로파일·그림)는 저장소 밖 hand-sonar-data/processed나 보고서 폴더에 둔다. 실수로 생겨도 넣지 않게
*.npy
*.npz
*.png
# 예외: data/의 데이터 묶음(export_data.py — 에코 프로파일만, 영상·원본 소리 없음)
!data/sessions/*/echo.npz
!data/recordings/*/echo.npz

# 학습한 모델도 저장소 밖 hand-sonar-data/processed/training에 둔다
*.pt
